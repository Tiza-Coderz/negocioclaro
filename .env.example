# Copie este archivo como .env.local y complete los valores.
# NUNCA suba .env.local al repositorio.

# --- Frontend (públicas: se incrustan en el bundle) ---
# URL y anon key de su proyecto Supabase (Settings → API)
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=su-anon-key

# Muestra credenciales demo en el login y el botón "Restablecer demo"
VITE_DEMO_MODE=true
VITE_DEMO_EMAIL=admin@demo.cu
VITE_DEMO_PASSWORD=demo1234

# Número de WhatsApp de contacto (formato internacional sin +), p. ej. 5351234567
VITE_CONTACT_WHATSAPP=5350000000

# --- Solo scripts locales (npm run seed). SECRETO: no usar en el frontend ---
SUPABASE_SERVICE_ROLE_KEY=su-service-role-key
